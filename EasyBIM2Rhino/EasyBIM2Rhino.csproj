<Project Sdk="Microsoft.NET.Sdk">
		
  <PropertyGroup>
    <!-- Select the framework(s) you wish to target.
        Rhino 6: net45
        Rhino 7: net48
        Rhino 8 Windows: net48, net7.0, net7.0-windows, net7.0-windows10.0.22000.0, etc
        Rhino 8 Mac: net7.0, net7.0-macos, net7.0-macos12.0, etc
    -->
    <TargetFrameworks>net48</TargetFrameworks>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Configurations>Debug-Rhino7;Release-Rhino7;Debug-Rhino8;Release-Rhino8</Configurations>
  </PropertyGroup>

  <!-- 编译符号：配置名含 Rhino7 则定义 RHINO_7，否则 RHINO_8 -->
  <PropertyGroup Condition="$(Configuration.Contains('Rhino7'))">
    <DefineConstants>$(DefineConstants);RHINO_7</DefineConstants>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="!$(Configuration.Contains('Rhino7'))">
    <DefineConstants>$(DefineConstants);RHINO_8</DefineConstants>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- Specifies information for Assembly and Yak -->
    <Version>1.0</Version>
    <Title>EasyBIM2Rhino</Title>
    <Company>EasyBIM2Rhino Authors</Company>
    <Description>Description of EasyBIM2Rhino</Description>
  </PropertyGroup>
  
  <!-- 根据配置引用不同版本的 RhinoCommon -->
  <Choose>
    <When Condition="$(Configuration.Contains('Rhino7'))">
      <ItemGroup>
        <PackageReference Include="RhinoCommon" Version="7.35.23346.11001" ExcludeAssets="runtime" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
      </ItemGroup>
    </Otherwise>
  </Choose>
  
  <!-- For Windows only builds -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4'))">
    <UseWpf>true</UseWpf>
  </PropertyGroup>

  <!-- 编译前自动重生成工具栏 .rui（把 assets 图标烤进去）；python 缺失时不阻断编译 -->
  <Target Name="GenRui" BeforeTargets="Build">
    <Exec Command="py &quot;$(ProjectDir)..\gen_rui.py&quot;" ContinueOnError="true" IgnoreExitCode="true" />
  </Target>

  <!-- 工具栏/图标按钮：与 .rhp 同名同目录输出，Rhino 首次加载插件时自动打开。
       按版本各带一份：Rhino7 槽位建议用 R7 工具栏编辑器产出并保存回 Toolbars\Rhino7\，保证 R7 位图兼容。 -->
  <ItemGroup Condition="$(Configuration.Contains('Rhino7'))">
    <Content Include="Toolbars\Rhino7\EasyBIM2Rhino.rui" Link="EasyBIM2Rhino.rui">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="!$(Configuration.Contains('Rhino7'))">
    <Content Include="Toolbars\Rhino8\EasyBIM2Rhino.rui" Link="EasyBIM2Rhino.rui">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>